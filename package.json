    "llm",
    "nlp",
    "typescript",
    "esm",
    "sdk",
    "client"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
